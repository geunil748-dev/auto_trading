# ============================================================
# 0. Application mode
# ============================================================
# Default is test. In test mode, KIS mock-investment settings are used and
# real-trading unlock flags are ignored.
# Use APP_MODE=real only on a separately approved real-trading deployment.
APP_MODE=test

# ============================================================
# 1. MSSQL 연결 정보
# ============================================================
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=TradingBot
MSSQL_USERNAME=sa
MSSQL_PASSWORD=
MSSQL_PROVIDER=auto
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# ============================================================
# 2. 한국투자증권 모의투자 Open API
# ============================================================
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=01
KIS_TOKEN_STORE=db
KIS_TOKEN_REFRESH_MARGIN_SECONDS=300
# 실서버는 true, 테스트서버는 false를 권장합니다. false면 유효 DB 토큰이 없을 때 새 발급을 막습니다.
KIS_ALLOW_TOKEN_REFRESH=false

# ============================================================
# 2-1. 한국투자증권 모의투자 웹소켓 준비
# ============================================================
# 아직 자동매매에는 연결하지 않았습니다. 실시간 시세/체결 수신을 붙일 때 사용합니다.
KIS_WS_ENABLED=false
KIS_WS_URL=
KIS_WS_APP_KEY=
KIS_WS_APP_SECRET=
KIS_WS_APPROVAL_KEY=
KIS_WS_ACCOUNT_NO=
KIS_WS_ACCOUNT_PRODUCT=01
KIS_WS_RECONNECT_SECONDS=5

# ============================================================
# 3. 한국투자증권 실투자 Open API
# ============================================================
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT=01

# ============================================================
# 3-1. 한국투자증권 실투자 웹소켓 준비
# ============================================================
# 실서버 전환 후 실시간 현재가/체결 통보를 받을 때 사용합니다.
KIS_REAL_WS_ENABLED=false
KIS_REAL_WS_URL=
KIS_REAL_WS_APP_KEY=
KIS_REAL_WS_APP_SECRET=
KIS_REAL_WS_APPROVAL_KEY=
KIS_REAL_WS_ACCOUNT_NO=
KIS_REAL_WS_ACCOUNT_PRODUCT=01
KIS_REAL_WS_RECONNECT_SECONDS=5

# ============================================================
# 4. AWS 연결 확인용 설정
# ============================================================
# 실제 배포 전 연결 확인에만 사용합니다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# 5. 모니터 보안
# ============================================================
# 브라우저와 모바일 앱에서 같은 토큰을 입력해야 /api/state 조회가 가능합니다.
MONITOR_BEARER_TOKEN=
# 로컬 PC에서만 접속하면 토큰 없이 통과할 수 있습니다.
MONITOR_ALLOW_LOCAL_BYPASS=true

# ============================================================
# 5-1. 종목 필터 조건
# ============================================================
# 후보 수집과 점수화에 사용하는 기본 필터입니다.
MIN_PRICE_USD=10
MAX_PRICE_USD=300
# KIS 해외주식 랭킹 API는 현재 응답 기준 최대 100건까지만 반환하므로 기본값은 100으로 둡니다.
# 설정값을 100보다 크게 올려도 현재 확인된 API 응답은 100건으로 제한됩니다.
# TURNOVER_RANKING_LIMIT는 현재 KIS trade-vol 거래량 랭킹 limit로 사용됩니다. 거래대금 랭킹 trade-pbmn이 아닙니다.
GAINER_RANKING_LIMIT=100
TURNOVER_RANKING_LIMIT=100
# Candidate ranking mode:
# - intersection: default safety mode, keeps the existing ranking-intersection path.
# - composite: experimental mode, scores price-fluctuation + trade-volume + trade-value ranks together.
# Run backtest-compare / intraday-backtest-compare before using composite in live operations.
RANKING_SELECTION_MODE=intersection
# 상승률/거래량/거래대금 랭킹 합집합은 유지하되, 시세/일봉 조회는 랭킹 상위부터 단계적으로 평가합니다.
# 아래 값은 모두 1 이상이어야 하며 INITIAL_RANKED_EVALUATION_LIMIT는 MAX_RANKED_EVALUATION_CANDIDATES 이하여야 합니다.
INITIAL_RANKED_EVALUATION_LIMIT=50
RANKED_EVALUATION_BATCH_SIZE=25
MAX_RANKED_EVALUATION_CANDIDATES=125
TARGET_FILTERED_CANDIDATES=15
# CANDIDATE_EVAL_TIMEOUT_SECONDS는 0보다 커야 합니다.
CANDIDATE_EVAL_TIMEOUT_SECONDS=120
# ============================================================
# Manual buy list
# ============================================================
# 수동 매수 후보 리스트입니다. 자동 후보 수집/선정 한도와 별도로 추가되지만
# 기존 가격/거래량/점수/돌파/계좌 노출/주문 보호 조건을 우회하지 않습니다.
MANUAL_BUY_LIST_ENABLED=true
MANUAL_BUY_LIST_PATH=monitor/manual_buy_list.json
MAX_MANUAL_BUY_TICKERS=20
MAX_MANUAL_SELECTED_CANDIDATES=20
MIN_OPENING_PRICE_CHANGE=0
MIN_VOLUME_RATIO=1.00
MIN_TOTAL_SCORE=35
MAX_OPENING_GAP=0.30
ALLOW_RELAXED_CANDIDATE_FILTER=true
RELAX_OPENING_CHANGE_ONLY=false
STRATEGY_PRESET=current
ENABLE_PYRAMIDING=false
REFRESH_INTRADAY_CANDIDATES=false
CANDIDATE_SELECTION_MODE=fixed
NEWS_CACHE_TTL_MINUTES=30
MAX_ENTRY_PRICE_CHANGE=0.15
OVERHEAT_LIMIT_CONDITION_MODE=HARD_FILTER
BREAKOUT_HOLD_MINUTES=1
REQUIRE_5M_CLOSE_ABOVE_BREAKOUT=true
BREAKOUT_CLOSE_CONDITION_MODE=SOFT_SCORE
REQUIRE_5M_VOLUME_INCREASE=true
MIN_5M_VOLUME_INCREASE_PERCENT=5
VOLUME_INCREASE_CONDITION_MODE=SOFT_SCORE
REQUIRE_VWAP_OR_MA20=true
VWAP_MA20_CONDITION_MODE=HARD_FILTER
VWAP_MA20_CONDITION_TYPE=OR
REQUIRE_PULLBACK_REBREAK=true
PULLBACK_REBREAK_CONDITION_MODE=SOFT_SCORE

# 거래일 계산 기준입니다. 기본값 us_market은 미국 시장 날짜 기준으로 자정 넘어가는 문제를 막습니다.
# 선택값: us_market, korea_session, local_date
TRADING_DAY_MODE=us_market

# ============================================================
# 6. 실투자 주문 안전장치
# ============================================================
# 실투자 주문 코드를 붙이더라도 아래 값이 열리기 전에는 주문을 막습니다.
REAL_TRADING_ENABLED=false
REAL_EMERGENCY_STOP=true
# APP_MODE=real, REAL_TRADING_ENABLED=true, REAL_EMERGENCY_STOP=false, and the
# runtime manual unlock must all be satisfied before real order-capable paths open.
REAL_MAX_ORDER_KRW=100000
REAL_MAX_DAILY_ORDER_KRW=300000

# ============================================================
# 7. 알림 채널
# ============================================================
# 토큰/채팅 ID가 비어 있으면 알림을 보내지 않습니다.
ALERT_DISCORD_WEBHOOK_URL=
# 운영 텔레그램 알림은 ALERT_TELEGRAM_*를 우선 사용합니다.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# 기존 TELEGRAM_*는 하위 호환 fallback입니다.
# ALERT_*가 일부만 있고 TELEGRAM_*가 완전하면 legacy fallback으로 사용됩니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# 8. 매도 기준
# ============================================================
TAKE_PROFIT_RATE=0.10
PARTIAL_TAKE_PROFIT_ENABLED=true
TRAILING_STOP_ACTIVATION_RATE=0.03
# 조기청산/수익보호 규칙 검증용 LOG_ONLY 진단입니다. 기본값은 모두 OFF이며,
# 이번 설정만으로 실제 SellIntent나 주문 경로는 변경되지 않습니다.
EARLY_EXIT_DIAGNOSTICS_ENABLED=false
PROFIT_PROTECTION_EXIT_ENABLED=false
PROFIT_PROTECTION_TRIGGER_RATE=0.02
PROFIT_PROTECTION_FLOOR_RATE=-0.003
TIME_STOP_EXIT_ENABLED=false
TIME_STOP_MINUTES=30
TIME_STOP_MIN_PROFIT_RATE=0.0
EARLY_NEGATIVE_EXIT_ENABLED=false
EARLY_NEGATIVE_EXIT_MINUTES=10
EARLY_NEGATIVE_EXIT_RATE=0.0
LOW_PROFIT_60M_EXIT_ENABLED=false
LOW_PROFIT_60M_MINUTES=60
LOW_PROFIT_60M_MIN_PROFIT_RATE=0.01
PARTIAL_TAKE_PROFIT_SIM_TRIGGER_RATE=0.03
PARTIAL_TAKE_PROFIT_SIM_FRACTION=0.5

# ============================================================
# 9. 실투자 전 P1 안정성 보강
# ============================================================
# 손절 직후 같은 종목 재진입을 막는 시간(분)입니다.
STOP_LOSS_COOLDOWN_MINUTES=30
# 당일 연속 손절이 이 횟수 이상이면 신규 매수를 중단합니다.
MAX_CONSECUTIVE_STOP_LOSS_COUNT=3
# 주문 직전 최우선 매수/매도 호가 차이가 이 비율(%)보다 크면 매수를 막습니다.
MAX_BID_ASK_SPREAD_RATE=1.0
# 예상 체결가와 현재가 괴리가 이 비율(%)보다 크면 매수를 막습니다.
MAX_EXPECTED_FILL_PRICE_GAP_RATE=1.0
# KIS 주문 API 실패 시 추가 재시도 횟수와 재시도 간격(초)입니다.
MAX_ORDER_RETRY_COUNT=2
ORDER_RETRY_DELAY_SECONDS=3
# KEEP_REMAINING: 잔량 유지, CANCEL_REMAINING: 지정 시간 뒤 미체결 잔량 취소
PARTIAL_FILL_POLICY=KEEP_REMAINING
UNFILLED_CANCEL_AFTER_SECONDS=60
