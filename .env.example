# ============================================================
# 1. MSSQL 연결 정보
# ============================================================
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=TradingBot
MSSQL_USERNAME=sa
MSSQL_PASSWORD=
MSSQL_PROVIDER=auto
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# ============================================================
# 2. 한국투자증권 모의투자 Open API
# ============================================================
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT=01

# ============================================================
# 2-1. 한국투자증권 모의투자 웹소켓 준비
# ============================================================
# 아직 자동매매에는 연결하지 않았습니다. 실시간 시세/체결 수신을 붙일 때 사용합니다.
KIS_WS_ENABLED=false
KIS_WS_URL=
KIS_WS_APP_KEY=
KIS_WS_APP_SECRET=
KIS_WS_APPROVAL_KEY=
KIS_WS_ACCOUNT_NO=
KIS_WS_ACCOUNT_PRODUCT=01
KIS_WS_RECONNECT_SECONDS=5

# ============================================================
# 3. 한국투자증권 실투자 Open API
# ============================================================
KIS_REAL_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT=01

# ============================================================
# 3-1. 한국투자증권 실투자 웹소켓 준비
# ============================================================
# 실서버 전환 후 실시간 현재가/체결 통보를 받을 때 사용합니다.
KIS_REAL_WS_ENABLED=false
KIS_REAL_WS_URL=
KIS_REAL_WS_APP_KEY=
KIS_REAL_WS_APP_SECRET=
KIS_REAL_WS_APPROVAL_KEY=
KIS_REAL_WS_ACCOUNT_NO=
KIS_REAL_WS_ACCOUNT_PRODUCT=01
KIS_REAL_WS_RECONNECT_SECONDS=5

# ============================================================
# 4. AWS 연결 확인용 설정
# ============================================================
# 실제 배포 전 연결 확인에만 사용합니다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================
# 5. 모니터 보안
# ============================================================
# 브라우저와 모바일 앱에서 같은 토큰을 입력해야 /api/state 조회가 가능합니다.
MONITOR_BEARER_TOKEN=
# 로컬 PC에서만 접속하면 토큰 없이 통과할 수 있습니다.
MONITOR_ALLOW_LOCAL_BYPASS=true

# ============================================================
# 5-1. 종목 필터 조건
# ============================================================
# 후보 수집과 점수화에 사용하는 기본 필터입니다.
MIN_PRICE_USD=5
MAX_PRICE_USD=50
MIN_OPENING_PRICE_CHANGE=0.03
MIN_VOLUME_RATIO=1.50
MIN_TOTAL_SCORE=40
MAX_OPENING_GAP=0.20
NEWS_CACHE_TTL_MINUTES=30
MAX_ENTRY_PRICE_CHANGE=0.25
BREAKOUT_HOLD_MINUTES=0
REQUIRE_5M_CLOSE_ABOVE_BREAKOUT=false
REQUIRE_5M_VOLUME_INCREASE=false
REQUIRE_VWAP_OR_MA20=false
REQUIRE_PULLBACK_REBREAK=false

# 거래일 계산 기준입니다. 기본값 us_market은 미국 시장 날짜 기준으로 자정 넘어가는 문제를 막습니다.
# 선택값: us_market, korea_session, local_date
TRADING_DAY_MODE=us_market

# ============================================================
# 6. 실투자 주문 안전장치
# ============================================================
# 실투자 주문 코드를 붙이더라도 아래 값이 열리기 전에는 주문을 막습니다.
REAL_TRADING_ENABLED=false
REAL_EMERGENCY_STOP=true
REAL_MAX_ORDER_KRW=100000
REAL_MAX_DAILY_ORDER_KRW=300000

# ============================================================
# 7. 알림 채널
# ============================================================
# 토큰/채팅 ID가 비어 있으면 알림을 보내지 않습니다.
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ============================================================
# 8. 매도 기준
# ============================================================
TAKE_PROFIT_RATE=0.10
PARTIAL_TAKE_PROFIT_ENABLED=true
TRAILING_STOP_ACTIVATION_RATE=0.03

# ============================================================
# 9. 실투자 전 P1 안정성 보강
# ============================================================
# 손절 직후 같은 종목 재진입을 막는 시간(분)입니다.
STOP_LOSS_COOLDOWN_MINUTES=30
# 당일 연속 손절이 이 횟수 이상이면 신규 매수를 중단합니다.
MAX_CONSECUTIVE_STOP_LOSS_COUNT=3
# 주문 직전 최우선 매수/매도 호가 차이가 이 비율(%)보다 크면 매수를 막습니다.
MAX_BID_ASK_SPREAD_RATE=1.0
# 예상 체결가와 현재가 괴리가 이 비율(%)보다 크면 매수를 막습니다.
MAX_EXPECTED_FILL_PRICE_GAP_RATE=1.0
# KIS 주문 API 실패 시 추가 재시도 횟수와 재시도 간격(초)입니다.
MAX_ORDER_RETRY_COUNT=2
ORDER_RETRY_DELAY_SECONDS=3
# KEEP_REMAINING: 잔량 유지, CANCEL_REMAINING: 지정 시간 뒤 미체결 잔량 취소
PARTIAL_FILL_POLICY=KEEP_REMAINING
UNFILLED_CANCEL_AFTER_SECONDS=60
